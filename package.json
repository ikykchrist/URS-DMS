{
  "name": "urs-dms-monorepo",
  "version": "1.5.0",
  "private": true,
  "description": "URS-DMS monorepo root (Sprint 1 client + Sprint 2 server)",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --workspace server run dev",
    "dev:client:remote": "npm --prefix client run dev -- --mode remote",
    "dev:server:remote": "npm --workspace server exec -- npx tsx watch --env-file=../.env.remote src/server.ts",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --workspace server run build",
    "lint:client": "npm --prefix client run lint",
    "lint:server": "npm --workspace server run lint",
    "typecheck:client": "npm --prefix client exec tsc -- --noEmit",
    "typecheck:server": "npm --workspace server run typecheck",
    "prisma:generate": "npm --workspace server run prisma:generate",
    "prisma:migrate": "npm --workspace server run prisma:migrate",
    "prisma:deploy": "npm --workspace server run prisma:deploy",
    "prisma:seed": "npm --workspace server run prisma:seed",
    "maintenance:storage-check": "node scripts/maintenance-storage-check.js",
    "maintenance:cleanup": "node scripts/maintenance-cleanup.js",
    "maintenance:run": "node scripts/maintenance-runner.js"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "k6": "^0.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.3.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
